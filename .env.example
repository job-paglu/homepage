# =============================================================================
# Job Paglu - backend + local-stack environment template
# -----------------------------------------------------------------------------
# WHAT THIS FILE IS
#   The single reference for every environment variable the Go backend and the
#   local docker-compose stack read. Copy it, then fill it in:
#
#       bash:        cp .env.example .env
#       PowerShell:  Copy-Item .env.example .env
#
#   `.env` is git-ignored. This file is committed and must therefore contain
#   PLACEHOLDERS ONLY - never a working connection string, password or secret,
#   not even for a throwaway environment. A plausible-looking value in a
#   committed template is how a fake credential ends up in production.
#
#   The frontend has its OWN template: frontend/.env.example. It is separate
#   because Astro only exposes variables prefixed `PUBLIC_` to the browser, so
#   the frontend's variable set is a different security class from this one -
#   mixing them in one file invites someone to move a secret across the line by
#   renaming it.
#
#   Every variable below states: what it does / required or optional / default.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Which environment this process believes it is running in.
# Drives: `Secure` on the session cookie (omitted only in development so plain
# http://localhost works), the cookie NAMES, verbose error detail, and the
# seed-data guard in scripts/dev.*.
#
# The cookie names are derived from this value, in one place
# (internal/config/config.go, Config.CookieName):
#   production   __Host-jp_session / __Host-jp_csrf
#   development  jp_session        / jp_csrf
# The `__Host-` prefix is what stops another host on a shared registrable domain
# from forging or shadowing our cookies, and a browser only accepts it on a
# Secure, Path=/, Domain-less cookie - which is why it is tied to this variable
# rather than set independently. See docs/SECURITY.md.
#
# Required: no. Default: production. Values: development | production
# Set this to `development` locally, or you will get a Secure-only cookie over
# http and the admin login will appear to succeed and then not stick.
APP_ENV=development

# TCP port the HTTP server listens on.
# Every hosting platform injects PORT itself and overrides whatever is set here;
# Vercel's Go runtime is no exception, and binding anything else makes the
# service unreachable. Bind all interfaces, never 127.0.0.1.
# Required: no. Default: 8080
PORT=8080

# Log verbosity.
# Required: no. Default: info. Values: debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by the backend (pgx/v5).
# Required: YES. No default - the server fails fast at startup if it is absent.
#
# Local (backend running on the host, Postgres in docker-compose):
#   postgres://USER:PASSWORD@localhost:5432/DBNAME?sslmode=disable
# Local (backend running INSIDE docker-compose):
#   the compose file builds this itself with host `db`; see the comment in
#   docker-compose.yml. Do not expect the value below to be used there.
# Production (Neon): sslmode=require is mandatory, never `disable`.
#   postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DB?sslmode=disable

# Apply pending SQL migrations from the embedded FS during startup.
# The migration runner is advisory-locked, so concurrent instances cannot race
# or double-apply. Safe to leave true locally - it is one less step.
#
# SET THIS TO false IN PRODUCTION. On a serverless host (DECISIONS D-20) the
# instance count is not something you control, so every cold start would pay a
# lock round-trip before answering its first request, a bad migration would
# surface as a platform deploy failure rather than a migration failure, and the
# thing that changed your schema would leave no log you can find. Apply them
# deliberately instead:
#
#   cd backend && go run ./cmd/adminctl migrate -dry-run   # report only
#   cd backend && go run ./cmd/adminctl migrate            # apply
#
# using the DIRECT (non-pooled) DATABASE_URL. See docs/DEPLOYMENT.md and
# .github/workflows/migrate.yml.
# Required: no. Default: true (see internal/config/config.go)
RUN_MIGRATIONS_ON_START=true

# Maximum Postgres connections in THIS PROCESS's pgx pool.
#
# The number that matters to Postgres is this value multiplied by the number of
# live instances, and on a serverless host nothing in this repository sets that
# count. So the default is deliberately tiny (2), and production must point
# DATABASE_URL at Neon's *pooled* endpoint - the `-pooler` hostname - which is
# what absorbs a fan-out the application cannot see.
#
# Raising this multiplies the problem by definition. The config layer refuses
# anything above 64 as a typo guard.
# Required: no. Default: 2 (see internal/database/db.go DefaultMaxConns)
DB_MAX_CONNS=2


# -----------------------------------------------------------------------------
# Local Postgres container (read by docker-compose.yml only)
# -----------------------------------------------------------------------------
# These configure the `db` service and are NOT read by the Go backend. They
# exist so `docker compose up` needs no arguments. The values are local-only
# throwaway credentials for a container with no data worth protecting; they are
# still placeholders here, and docker-compose.yml carries its own local
# defaults so the stack starts even if this section is left untouched.

# Required: no. Default (in compose): jobpaglu
POSTGRES_USER=jobpaglu

# Password for the local container only. Never reuse a real password here.
# Required: no. Default (in compose): jobpaglu_local_only
POSTGRES_PASSWORD=REPLACE_LOCAL_ONLY_PASSWORD

# Required: no. Default (in compose): jobpaglu
POSTGRES_DB=jobpaglu

# Host port the container publishes 5432 on. Change it if something already
# owns 5432 on your machine.
# Required: no. Default (in compose): 5432
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Sessions, CSRF and CORS
# -----------------------------------------------------------------------------

# Secret used to derive/pepper admin session material.
# Required: YES. No default - the server must refuse to start without it, and
# must refuse a short one. Minimum 32 bytes of real entropy; 48 is comfortable.
# Rotating it invalidates every live admin session, which is the intended
# emergency response to a suspected session-store compromise.
#
# Generate one (do NOT reuse the placeholder, and do not paste the output into
# any file other than .env):
#
#   bash / macOS / WSL / Git Bash:
#       openssl rand -base64 48
#
#   PowerShell 7.2+ - USE THIS ONE:
#       [Convert]::ToBase64String(
#         [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#
#   Windows PowerShell 5.1 - USE THIS ONE (the static GetBytes(int) overload
#   above is .NET 6+ and is not present on the .NET Framework that 5.1 runs on):
#       $b = [byte[]]::new(48)
#       [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($b)
#       [Convert]::ToBase64String($b)
#
#   PowerShell - the Get-Random one-liner you will find on the internet:
#       [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   DO NOT USE IT for this variable. `Get-Random` is a general-purpose PRNG, not
#   a CSPRNG: unseeded it draws from a deterministic generator whose state is
#   recoverable from a modest number of outputs, so the "48 random bytes" can be
#   far less than 48 bytes of entropy. A guessable session secret means forgeable
#   admin sessions. The two CSPRNG forms above use the OS entropy source.
#
# The placeholder below is chosen so the server REJECTS it rather than starting
# with it. internal/config/config.go requires at least 32 characters and refuses
# anything containing a template marker such as `changeme` or `generate`, so a
# forgotten placeholder fails at boot instead of becoming a live session key.
# Do not "fix" that failure by lengthening the placeholder - replace it.
ADMIN_SESSION_SECRET=CHANGEME_generate_a_real_value_with_the_command_above

# Exact origin of the frontend, scheme included, no trailing slash.
# Used for the CORS allowlist (exactly one origin, never `*` for credentialed
# requests) and for the Origin check on state-changing admin requests.
# A mismatch here is the usual cause of a login that returns 200 and then 403s
# on the next write.
#
# In the recommended single-origin topology this is the SITE's origin, e.g.
#   FRONTEND_URL=https://home.jobpaglu.eu.cc
# The browser talks only to that origin; the site's /api/* route forwards to the
# API deployment server-to-server and passes the browser's Origin through
# unchanged, so this value is still exactly what the backend sees.
#
# This is not a "defence in depth" nicety on the production domain. The site's
# registrable domain (`eu.cc` per the Public Suffix List) is shared with
# strangers, so SameSite=Lax does NOT stop a cross-origin POST from a
# neighbouring host. This Origin check and the X-CSRF-Token check are the two
# controls that actually hold. See docs/SECURITY.md.
#
# Required: YES, always. There is no default - the server refuses to start
# without it, and requires an absolute http:// or https:// URL with a host.
FRONTEND_URL=http://localhost:4321


# -----------------------------------------------------------------------------
# Content policy
# -----------------------------------------------------------------------------

# Allow `http://` (not just `https://`) in a job's apply_url.
# The apply URL is handed straight to a visitor's browser, so the validator is
# an allowlist. Turning this on is for local testing against an http-only
# staging site and nothing else.
# Required: no. Default: false. MUST stay false in production.
ALLOW_HTTP_APPLY_URLS=false


# -----------------------------------------------------------------------------
# One-shot bootstrap
# -----------------------------------------------------------------------------

# Initial admin password, consumed once by `cmd/adminctl` when creating the
# first administrator, then discarded. It is NOT read by the HTTP server.
# Do not leave a real value sitting in .env after the account exists - create
# the admin, then delete the line.
# Required: no (only for the very first admin). Default: none.
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_ONLY_WHEN_CREATING_FIRST_ADMIN

# Email address for that first administrator. Not a secret.
# Required: no. Default: none.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Integration tests (CI and local)
# -----------------------------------------------------------------------------

# Connection string for the throwaway database the `-tags=integration` suite
# runs against. It is truncated and re-migrated by the tests, so it must NEVER
# point at a database you care about.
# Required: only when running the integration suite. Default: none (suite skips).
TEST_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DB_test?sslmode=disable
