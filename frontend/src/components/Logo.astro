---
/**
 * The Job Paglu lockup: the brand mascot avatar + the "Job Paglu" wordmark.
 *
 * The avatar is the real Job Paglu logo used on the apex site jobpaglu.eu.cc
 * (its profile avatar) — the orange mascot at a laptop — served locally from
 * public/brand/job-paglu-logo.jpg rather than hotlinked, so there is no external
 * request and no CSP allowance to make. It is shown as a circle, exactly as the
 * apex renders it (an avatar image beside the name), so both properties carry
 * the same logo.
 *
 * NOTE: this is a raster logo with baked-in "Job Paglu"/"Remote Jobs Made Fun"
 * text. If a crisp vector or a transparent-background version becomes available,
 * swap the file — the markup does not change.
 */
import styles from '@styles/logo.module.css';
import { copy } from '@lib/copy';
import { ROUTES } from '@lib/urls';

interface Props {
  /** Target for the home link. `false` renders a non-link mark. */
  href?: string | false;
  size?: 'md' | 'lg';
  /** Kept for API compatibility; the avatar is a fixed image, so it is a no-op. */
  inverse?: boolean;
  /** Force a `<span>` — for use inside a heading that is already a link. */
  as?: 'a' | 'span';
}

const { href = ROUTES.home, size = 'md', inverse = false, as } = Astro.props;

const Tag = as ?? (href === false ? 'span' : 'a');
/**
 * Narrowed in one place so `href` can never reach the template as `false` and
 * be rendered as the literal string "false".
 */
const linkHref = Tag === 'a' && href !== false ? href : undefined;

/**
 * Joined by hand rather than with `class:list`: the tag here is dynamic, and a
 * plain `class` string is the one form that is unambiguous for both an element
 * and a component render.
 */
const classes = [styles.logo, size === 'lg' ? styles.lg : null, inverse ? styles.inverse : null]
  .filter((value): value is string => typeof value === 'string')
  .join(' ');
---

<Tag
  class={classes}
  href={linkHref}
  aria-label={linkHref === undefined ? undefined : copy.nav.logoHome}
>
  {/* Decorative: the wordmark beside it already carries the accessible name.
      The real Job Paglu mascot logo, shown as a circular avatar like the apex. */}
  <img
    class={styles.glyph}
    src="/brand/job-paglu-logo.jpg"
    alt=""
    width="64"
    height="64"
    loading="eager"
    decoding="async"
  />
  <span>
    <span class={styles.first}>{copy.site.wordmarkFirst}</span>{' '}<span
      class={styles.second}>{copy.site.wordmarkSecond}</span
    ></span
  >
</Tag>
