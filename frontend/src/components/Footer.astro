---
/**
 * Site footer.
 *
 * Also the no-JavaScript fallback for mobile navigation, which is why its links
 * carry the same 44px touch floor as the menu panel rather than being the usual
 * cramped 13px legal row.
 *
 * The year is computed at render time. These pages are SSR'd or prerendered, so
 * a prerendered page's year is fixed at build time — acceptable, and far better
 * than shipping a script to update a single number.
 */
import Logo from '@components/Logo.astro';
import styles from '@styles/footer.module.css';
import { copy } from '@lib/copy';
import { ROUTES, OWNED_EXTERNAL } from '@lib/urls';

const year = new Date().getUTCFullYear();

// Explicitly annotated rather than `as const`: a const array becomes a UNION of
// literal object types, and reading `.external` off a union where only one member
// declares it is a type error. Same annotation as Header's list, deliberately, so
// one shape feeds both.
const explore: ReadonlyArray<{
  href: string;
  label: string;
  external?: boolean;
  ariaLabel?: string;
}> = [
  { href: ROUTES.home, label: copy.nav.home },
  { href: ROUTES.jobs, label: copy.nav.jobs },
  // The apex site, which carries its own job links. Owned, so no nofollow.
  {
    href: OWNED_EXTERNAL.mainSite,
    label: copy.nav.jobLinks,
    external: true,
    ariaLabel: copy.nav.jobLinksAria,
  },
  {
    href: OWNED_EXTERNAL.resume,
    label: copy.nav.resume,
    external: true,
    ariaLabel: copy.nav.resumeAria,
  },
];

const legal = [
  { href: ROUTES.privacy, label: copy.nav.privacy },
  { href: ROUTES.terms, label: copy.nav.terms },
] as const;
---

<footer class={styles.footer}>
  <div class:list={['jp-container', styles.inner]}>
    <div class={styles.about}>
      <Logo />
      <p class={styles.blurb}>{copy.footer.blurb}</p>
      {/* Amber background carrying --jp-ink: the only sanctioned use of the
          accent token (tokens.css contrast notes). */}
      <p class={styles.notice}>{copy.footer.freeNotice}</p>
    </div>

    <nav class={styles.group} aria-label={copy.footer.exploreHeading}>
      <h2 class={styles.groupTitle}>{copy.footer.exploreHeading}</h2>
      <ul class={styles.list}>
        {
          explore.map((link) => (
            <li>
              <a
                class={styles.link}
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-label={link.ariaLabel}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class={styles.group} aria-label={copy.footer.legalHeading}>
      <h2 class={styles.groupTitle}>{copy.footer.legalHeading}</h2>
      <ul class={styles.list}>
        {
          legal.map((link) => (
            <li>
              <a class={styles.link} href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="jp-container">
    <div class={styles.bottom}>
      <p>{`${copy.footer.copyrightPrefix} ${year} ${copy.footer.copyrightSuffix}`}</p>
      <p class={styles.tagline}>{copy.site.tagline}</p>
    </div>
  </div>
</footer>
