---
/**
 * Sticky site header.
 *
 * Two navigations rather than one restyled nav: the desktop `<ul>` and the
 * mobile panel need different markup (the panel owns the Escape/focus
 * behaviour), and duplicating four links is far cheaper than a component trying
 * to be both. Only one is in the layout at any width, so there is no duplicate
 * landmark for a screen reader to wade through.
 *
 * A `<noscript>` copy of the same links exists because the hamburger needs a
 * script to open: without it, a phone visitor with JavaScript blocked would
 * have no header navigation at all.
 */
import Button from '@components/Button.astro';
import Logo from '@components/Logo.astro';
import MobileMenu from '@components/MobileMenu.astro';
import styles from '@styles/header.module.css';
import { copy } from '@lib/copy';
import { isCurrentPath, ROUTES, OWNED_EXTERNAL } from '@lib/urls';

interface Props {
  /** `Astro.url.pathname`, for aria-current. */
  currentPath: string;
}

const { currentPath } = Astro.props;

/**
 * One list, rendered three times: the desktop nav, the mobile panel, and the
 * `<noscript>` fallback. Adding an entry here reaches all three, which is why
 * the external link goes in the list rather than being hand-placed in one of
 * them and quietly missing from the other two.
 *
 * `external` items point at a site we own (see OWNED_EXTERNAL), so they get
 * `noopener noreferrer` but NOT `nofollow`.
 */
const links: ReadonlyArray<{
  href: string;
  label: string;
  external?: boolean;
  ariaLabel?: string;
}> = [
  { href: ROUTES.home, label: copy.nav.home },
  { href: ROUTES.jobs, label: copy.nav.jobs },
  {
    href: OWNED_EXTERNAL.mainSite,
    label: copy.nav.jobLinks,
    external: true,
    ariaLabel: copy.nav.jobLinksAria,
  },
];
---

<header class={styles.header}>
  <div class:list={['jp-container', styles.inner]}>
    <div class={styles.brand}>
      <Logo />
    </div>

    <nav class={styles.desktopNav} aria-label={copy.nav.primaryLabel}>
      <ul class={styles.list}>
        {
          links.map((link) => (
            <li>
              <a
                class={styles.link}
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-label={link.ariaLabel}
                aria-current={
                  !link.external && isCurrentPath(currentPath, link.href) ? 'page' : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <Button href={ROUTES.jobs} variant="primary" size="sm" class={styles.cta}>
            {copy.home.heroPrimaryCta}
          </Button>
        </li>
      </ul>
    </nav>

    <MobileMenu links={links} currentPath={currentPath} />
  </div>

  <noscript>
    <div class="jp-container">
      <ul class={styles.noscriptNav}>
        {
          links.map((link) => (
            <li>
              <a
                class={styles.link}
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-label={link.ariaLabel}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class={styles.link} href={ROUTES.privacy}>{copy.nav.privacy}</a>
        </li>
        <li>
          <a class={styles.link} href={ROUTES.terms}>{copy.nav.terms}</a>
        </li>
      </ul>
    </div>
  </noscript>
</header>
